# Express Backend
PORT=5000
MONGO_URI=mongodb://localhost:27017/eyeonsite
INTERNAL_API_KEY=your_secret_key

# Python AI Service
PYTHON_PORT=8000
EXPRESS_URL=http://localhost:5000
MACHINE_MARGIN=100
FRAME_SKIP=2
YOLO_IMGSZ=640
PREDICTIVE_COOLDOWN_FRAMES=10

# Frontend (also set in frontend/.env)
VITE_EXPRESS_URL=http://localhost:5000
VITE_PYTHON_STREAM_URL=http://localhost:8000

# ── New variables for SOP v2.0 features ──────────────────────────────────
# Feature 1: Model path
YOLO_MODEL=yolov8s.pt

# Feature 2: Distance calculation calibration
REFERENCE_OBJECT_REAL_CM=30.0
REFERENCE_OBJECT_PX=60.0

# Feature 3: Body cube overlay
BODY_CUBE_DEPTH_RATIO=0.35
BODY_CUBE_PERSPECTIVE=0.6

# Feature 4: No-movement detection
STILL_THRESHOLD_PX=15.0
STILL_ALERT_SECS=15.0
